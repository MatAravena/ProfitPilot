# ── App ────────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
# DEBUG=true echoes exception tracebacks + raw error messages in API responses.
# Safe on a local box; MUST be false on anything network-reachable (it leaks internals).
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://profitpilot:profitpilot_dev@localhost:5432/profitpilot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Market Data ────────────────────────────────────────────────────────────────
# Crypto candles come from Bybit's public API — no keys needed.
# Stock/ETF candles come from Alpaca, which requires a FREE account's API key+secret
# (no funding needed): https://alpaca.markets → generate keys. Leave blank to fall
# back to Yahoo Finance for stocks. The free "iex" feed has thinner history than "sip".
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
MARKET_CACHE_TTL_SECONDS=60

# ── LLM Enrichment (all optional) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Model Storage ──────────────────────────────────────────────────────────────
MODEL_ARTIFACT_DIR=./model_artifacts
MODEL_ARTIFACT_S3_BUCKET=

# ── Risk Defaults (overridable per strategy instance) ─────────────────────────
DEFAULT_MAX_POSITION_SIZE_PCT=0.02
DEFAULT_MAX_OPEN_POSITIONS=5
DEFAULT_MAX_DAILY_DRAWDOWN_PCT=0.03
DEFAULT_MAX_TOTAL_DRAWDOWN_PCT=0.10
DEFAULT_STOP_LOSS_PCT=0.015

# ── Auth ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440
