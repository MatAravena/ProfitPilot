{
  "name": "profitpilot",
  "private": true,
  "scripts": {
    "fe": "npm --prefix frontend run dev",
    "be": "cd backend && python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "start": "concurrently -n FE,BE -c cyan,green \"npm run fe\" \"npm run be\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
