{
  "name": "profit-pilot",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "fastapi-req": "pip install -r ./api/requirements.txt",
    "fastapi-dev": "python -m uvicorn api.index:app --reload",
    "be": "npm run fastapi-req && npm run fastapi-dev",

    "fe":"cd app && npm run dev",

    "dev": "concurrently \"npm run next-dev\" \"npm run be\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  }
}
