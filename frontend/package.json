{
  "name": "profitpilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "fe": "vite",
    "be": "cd ../backend && python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "start": "concurrently -n FE,BE -c cyan,green \"npm run fe\" \"npm run be\""
  },
  "dependencies": {
