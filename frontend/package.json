    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "msw": "^2.14.3",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
